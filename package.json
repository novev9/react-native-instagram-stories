{
  "name": "@novev9/react-native-instagram-stories",
  "version": "1.0.0",
  "description": "Instagram-style stories for React Native — true 3D cube transition, Fabric / New Architecture ready, headless content (render prop), pluggable storage.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "stories",
    "instagram",
    "instagram-stories",
    "story",
    "cube",
    "3d",
    "fabric",
    "new-architecture",
    "reanimated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novev9/react-native-instagram-stories.git"
  },
  "author": "Evgeny Novikov",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./async-storage": {
      "import": "./lib/module/async-storage/index.js",
      "require": "./lib/commonjs/async-storage/index.js",
      "types": "./lib/typescript/async-storage/index.d.ts",
      "react-native": "./src/async-storage/index.ts",
      "default": "./lib/module/async-storage/index.js"
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "react": "19.0.0",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.30.0",
    "react-native-gesture-handler": "^2.31.0",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-svg": "^15.0.0",
    "typescript": "^5.4.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
